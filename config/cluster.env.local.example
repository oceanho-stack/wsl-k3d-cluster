# Machine-specific overrides. Copy to config/cluster.env.local and edit.
# This file is git-ignored.

# Windows host proxy reachable from WSL. Find the Windows LAN IP with `ipconfig`,
# or use the WSL default gateway: ip route show default | awk '{print $3}'.
# PROXY_URL="http://192.168.0.111:7897"

# If your ports are taken:
# HTTP_PORT=18080
# HTTPS_PORT=18443
# API_PORT=16443
# REGISTRY_PORT=15000

# Pin different versions (then run `make images` again):
# K3D_VERSION=v5.9.0
# K3S_VERSION=v1.35.5-k3s1
