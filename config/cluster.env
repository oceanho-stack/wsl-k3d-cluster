# =============================================================================
# k3d on WSL - central configuration
#
# Every value uses ${VAR:-default}, so you can override any of them from the
# environment or from config/cluster.env.local (recommended, git-ignored).
# =============================================================================

# ----- cluster identity ------------------------------------------------------
CLUSTER_NAME="${CLUSTER_NAME:-dev}"

# ----- pinned versions (change deliberately, then rebuild the image cache) ---
K3D_VERSION="${K3D_VERSION:-v5.9.0}"
K3S_VERSION="${K3S_VERSION:-v1.35.5-k3s1}"

# ----- k3d installation ------------------------------------------------------
K3D_INSTALL_DIR="${K3D_INSTALL_DIR:-$HOME/.local/bin}"

# ----- kernel limits ---------------------------------------------------------
# k3s containerd's CRI plugin and kube-apiserver each create inotify instances.
# The per-UID limit is shared with every root container on the box (other kind
# clusters, build containers), so the stock 128 is easily exhausted and the
# cluster create rolls back. scripts/install.sh raises these idempotently.
INOTIFY_MAX_USER_INSTANCES="${INOTIFY_MAX_USER_INSTANCES:-8192}"
INOTIFY_MAX_USER_WATCHES="${INOTIFY_MAX_USER_WATCHES:-2097152}"
INOTIFY_MAX_QUEUED_EVENTS="${INOTIFY_MAX_QUEUED_EVENTS:-65536}"
INOTIFY_SYSCTL_FILE="${INOTIFY_SYSCTL_FILE:-/etc/sysctl.d/99-k3d-inotify.conf}"

# ----- topology / host ports -------------------------------------------------
SERVERS="${SERVERS:-1}"
AGENTS="${AGENTS:-1}"
API_PORT="${API_PORT:-6443}"
HTTP_PORT="${HTTP_PORT:-8080}"
HTTPS_PORT="${HTTPS_PORT:-8443}"

# ----- built-in local registry ----------------------------------------------
ENABLE_REGISTRY="${ENABLE_REGISTRY:-1}"
# Never use the bare name "registry": it collides with common Harbor/registry
# containers and the cluster rollback leaves debris behind.
REGISTRY_NAME="${REGISTRY_NAME:-k3d-registry-${CLUSTER_NAME}}"
REGISTRY_PORT="${REGISTRY_PORT:-5000}"

# ----- images ----------------------------------------------------------------
# Pull missing images before creating a cluster (needs network once).
PREPARE_IMAGES="${PREPARE_IMAGES:-1}"
# Import the k3s system images into a freshly created cluster, so the cluster
# never needs to reach Docker Hub at runtime.
IMPORT_IMAGES="${IMPORT_IMAGES:-1}"
PULL_TIMEOUT="${PULL_TIMEOUT:-300}"

# Mirrors are only used when a direct `docker pull` fails.
DOCKERHUB_MIRROR="${DOCKERHUB_MIRROR:-https://docker.m.daocloud.io}"
GHCR_MIRROR="${GHCR_MIRROR:-https://ghcr.m.daocloud.io}"

DEMO_IMAGE="${DEMO_IMAGE:-traefik/whoami:v1.10.2}"
BUSYBOX_IMAGE="${BUSYBOX_IMAGE:-busybox:1.36.1}"
# local-path-provisioner creates helper Pods with this image. k3s v1.35.5
# pins rancher/mirrored-library-busybox:1.37.0; a plain `busybox` will not do.
HELPER_IMAGE="${HELPER_IMAGE:-rancher/mirrored-library-busybox:1.37.0}"

# ----- network / proxy -------------------------------------------------------
# Example for a Windows proxy reachable from WSL:
#   PROXY_URL="http://192.168.0.111:7897"
# Leave empty for direct access or mirror-only setups.
PROXY_URL="${PROXY_URL:-}"
NO_PROXY_LIST="${NO_PROXY_LIST:-localhost,127.0.0.1,::1,10.42.0.0/16,10.43.0.0/16,172.22.0.0/16,.local,.internal}"

# Optional prefix for the k3d binary download, e.g. https://ghfast.top/
K3D_DOWNLOAD_MIRROR="${K3D_DOWNLOAD_MIRROR:-}"
SKIP_CHECKSUM="${SKIP_CHECKSUM:-0}"

# ----- behaviour -------------------------------------------------------------
WAIT_TIMEOUT="${WAIT_TIMEOUT:-300s}"
ASSUME_YES="${ASSUME_YES:-0}"

# Optional: extra k3d create flags, e.g. --k3s-arg="--disable=metrics-server@server:*"
K3D_CREATE_EXTRA_ARGS="${K3D_CREATE_EXTRA_ARGS:-}"

# Optional: path to a containerd registries.yaml. Usually unnecessary because
# the kit imports all system images; use it for extra private-registry mirrors.
REGISTRY_CONFIG="${REGISTRY_CONFIG:-}"
